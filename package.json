{
  "name": "termstep",
  "version": "1.4.0",
  "description": "Local macOS app to run CLI commands via menus and buttons",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "dev:web": "vite",
    "build": "tauri build",
    "build:web": "vite build",
    "typecheck": "tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "icon": "tauri icon assets/icon.png",
    "version:set": "node scripts/set-version.mjs",
    "package": "tauri build",
    "release": "tauri build --target universal-apple-darwin && mkdir -p release && cp src-tauri/target/universal-apple-darwin/release/bundle/dmg/*.dmg release/"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@types/markdown-it": "^14.1.2",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "typescript": "^5.5.0",
    "vite": "^5.3.0",
    "vitest": "^2.0.0"
  },
  "dependencies": {
    "@codemirror/lang-markdown": "^6.3.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@uiw/react-codemirror": "^4.23.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "markdown-it": "^14.1.0"
  }
}
