# dependencies
node_modules/

# build output (Vite → dist/, Rust → src-tauri/target/, installers → release/)
dist/
out/
release/
build/

# logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# macOS
.DS_Store

# editor
.vscode/
.idea/

# superpowers subagent-driven-dev scratch (progress ledger)
.superpowers/

# git worktrees (local isolation workspaces)
.worktrees/

# Tauri generated icons (regenerated via `npm run icon`, source kept in assets/)
src-tauri/icons/
# Tauri generated capability schemas (regenerated on build)
src-tauri/gen/
# Rust build artifacts
src-tauri/target/

# TermStep 工具生成器（termstep-tool-gen skill）的运行时产物——
# 每次为当前项目重新生成，是给 TermStep 工具消费的，非项目源码
termstep-help.md
termstep-tool.json

# ZCode 本地工作区（agent 缓存/会话等，机具本机相关）
.zcode/

# TermStep 用户数据软链（指向 ~/Library/Application Support/TermStep，仅本机调试用）
ln_config_data
